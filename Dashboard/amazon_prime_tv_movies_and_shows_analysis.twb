      <table>
        <view>
          <datasources>
            <datasource caption='cleaned_merged_dataset' name='federated.0fhm70s17cpjs31br7j3n1nntmal' />
          </datasources>
          <datasource-dependencies datasource='federated.0fhm70s17cpjs31br7j3n1nntmal'>
            <column caption='Total Movies ' datatype='integer' name='[Calculation_0587416677937155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [type] = &quot;MOVIE&quot; THEN [id] END&#13;&#10;)' />
            </column>
            <column caption='Total Shows' datatype='integer' name='[Calculation_0587416678064132]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [type] = &quot;SHOW&quot; THEN [id] END&#13;&#10;)' />
            </column>
            <column caption='Recent Content %' datatype='real' name='[Calculation_0587416678166533]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([is_recent]) / COUNT([id])' />
            </column>
            <column-instance column='[id]' derivation='Count' name='[cnt:id:qk]' pivot='key' type='quantitative' />
            <column-instance column='[genre_category]' derivation='CountD' name='[ctd:genre_category:qk]' pivot='key' type='quantitative' />
            <column-instance column='[type]' derivation='CountD' name='[ctd:type:qk]' pivot='key' type='quantitative' />
            <column caption='Genre Category' datatype='string' name='[genre_category]' role='dimension' type='nominal' />
            <column caption='Id' datatype='string' name='[id]' role='dimension' type='nominal' />
            <column caption='Is Recent' datatype='integer' name='[is_recent]' role='measure' type='quantitative' />
            <column-instance column='[runtime]' derivation='Median' name='[med:runtime:qk]' pivot='key' type='quantitative' />
            <column-instance column='[release_year]' derivation='None' name='[none:release_year:qk]' pivot='key' type='quantitative' />
            <column caption='Rating Category' datatype='string' name='[rating_category]' role='dimension' type='nominal' />
            <column caption='Release Year' datatype='integer' name='[release_year]' role='dimension' type='quantitative' />
            <column caption='Runtime' datatype='integer' name='[runtime]' role='measure' type='quantitative' />
            <column caption='Type' datatype='string' name='[type]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0587416677937155]' derivation='User' name='[usr:Calculation_0587416677937155:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0587416678064132]' derivation='User' name='[usr:Calculation_0587416678064132:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0587416678166533]' derivation='User' name='[usr:Calculation_0587416678166533:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
