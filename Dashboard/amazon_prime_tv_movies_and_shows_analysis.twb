      <column caption='Total Titles' datatype='integer' name='[Calculation_0587416677629952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([id])' />
      </column>
      <column caption='Avg Imdb Score' datatype='real' name='[Calculation_0587416677736449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([imdb_score])' />
      </column>
      <column caption='Avg Tmdb Popularity' datatype='real' name='[Calculation_0587416677822466]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([tmdb_popularity])' />
      </column>
      <column caption='Total Movies ' datatype='integer' name='[Calculation_0587416677937155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [type] = &quot;MOVIE&quot; THEN [id] END&#13;&#10;)' />
      </column>
      <column caption='Total Shows' datatype='integer' name='[Calculation_0587416678064132]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [type] = &quot;SHOW&quot; THEN [id] END&#13;&#10;)' />
      </column>
      <column caption='Recent Content %' datatype='real' name='[Calculation_0587416678166533]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_recent]) / COUNT([id])' />
      </column>
      <column caption='Content Type' datatype='string' name='[Calculation_0587416682782726]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_recent] = 1 THEN &quot;Recent&quot;&#13;&#10;ELSE &quot;Old&quot;&#13;&#10;END' />
      </column>
      <column caption='Map Region' datatype='string' name='[Calculation_0587416693661706]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
        <calculation class='tableau' formula='IF [country_region] = &quot;Asia&quot; THEN &quot;India&quot;&#13;&#10;ELSEIF [country_region] = &quot;Europe&quot; THEN &quot;France&quot;&#13;&#10;ELSEIF [country_region] = &quot;North America&quot; THEN &quot;United States&quot;&#13;&#10;ELSEIF [country_region] = &quot;South America&quot; THEN &quot;Brazil&quot;&#13;&#10;ELSEIF [country_region] = &quot;Oceania&quot; THEN &quot;Australia&quot;&#13;&#10;ELSE &quot;Unknown&quot;&#13;&#10;END' />
      </column>
